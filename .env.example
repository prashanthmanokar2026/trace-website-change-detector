# Copy to .env; never commit .env. Use scripts/set_password.py to set the hash.
TRACE_BASE_URL=http://127.0.0.1:8000
TRACE_OWNER_HASH=
TRACE_PROXY=http://127.0.0.1:8899
TRACE_RETENTION=50
TRACE_DOMAIN_DELAY=15
# Optional channels. Both remain disabled until enabled in owner settings.
TRACE_SMTP_HOST=
TRACE_SMTP_PORT=587
TRACE_SMTP_USER=
TRACE_SMTP_PASSWORD=
TRACE_EMAIL_FROM=
TRACE_EMAIL_TO=
TRACE_DISCORD_WEBHOOK=
# Deployment only: a domain whose DNS points to your server.
TRACE_DOMAIN=trace.example.com
